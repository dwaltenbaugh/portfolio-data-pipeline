# Airflow
AIRFLOW_UID=50000
FERNET_KEY=replace_with_generated_fernet_key

# Open Food Facts
OPENFOODFACTS_USER_AGENT="portfolio-data-pipeline/0.1 (https://github.com/dwaltenbaugh/portfolio-data-pipeline)"
OPENFOODFACTS_INITIAL_WATERMARK=2026-08-01T00:00:00+00:00
OPENFOODFACTS_LOOKBACK_HOURS=24
OPENFOODFACTS_MAX_PAGES=5

# Local MinIO
MINIO_ACCESS_KEY=portfolio_dev
MINIO_SECRET_KEY=replace_with_local_minio_password
S3_ENDPOINT_URL=http://localhost:9000
RAW_BUCKET=portfolio-data-pipeline-dev

# AWS integrations currently used for CloudWatch/SNS
AWS_ACCOUNT_ID=replace_with_aws_account_id
AWS_DEFAULT_REGION=us-east-1
SNS_ALERT_TOPIC_NAME=portfolio-data-pipeline-alerts

# Local pipeline PostgreSQL
PIPELINE_DB_NAME=portfolio
PIPELINE_DB_USER=portfolio_user
PIPELINE_DB_PASSWORD=replace_with_local_database_password
PIPELINE_DB_HOST=localhost
PIPELINE_DB_PORT=5433