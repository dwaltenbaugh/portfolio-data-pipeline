# Environment
PIPELINE_ENV=prod

# Immutable image built and pushed by CI
AIRFLOW_IMAGE_NAME=replace_with_registry/image:replace_with_commit_sha

# Airflow security
AIRFLOW_UID=50000
FERNET_KEY=replace_with_production_fernet_key
AIRFLOW_API_AUTH_JWT_SECRET=replace_with_production_jwt_secret
AIRFLOW_ADMIN_USERNAME=airflow_admin
AIRFLOW_ADMIN_PASSWORD=replace_with_strong_admin_password

# Externally managed Airflow PostgreSQL and Redis
AIRFLOW_DATABASE_URL=postgresql+psycopg2://airflow:replace_with_secret@replace_with_airflow_database_host:5432/airflow
AIRFLOW_RESULT_BACKEND=db+postgresql+psycopg2://airflow:replace_with_secret@replace_with_airflow_database_host:5432/airflow
AIRFLOW_BROKER_URL=rediss://:replace_with_secret@replace_with_redis_host:6379/0

# Open Food Facts
OPENFOODFACTS_USER_AGENT="portfolio-data-pipeline/0.1 (https://github.com/dwaltenbaugh/portfolio-data-pipeline)"
OPENFOODFACTS_INITIAL_WATERMARK=2026-08-01T00:00:00+00:00
OPENFOODFACTS_LOOKBACK_HOURS=24

# AWS S3, CloudWatch, and SNS
AWS_ACCOUNT_ID=replace_with_aws_account_id
AWS_DEFAULT_REGION=us-east-1
RAW_BUCKET=replace_with_production_bucket
SNS_ALERT_TOPIC_NAME=portfolio-data-pipeline-prod-alerts
AIRFLOW_REMOTE_BASE_LOG_FOLDER=replace_with_cloudwatch_log_arn

# Externally managed pipeline PostgreSQL
PIPELINE_DB_NAME=portfolio_prod
PIPELINE_DB_USER=portfolio_pipeline
PIPELINE_DB_PASSWORD=replace_with_secret
PIPELINE_DB_HOST=replace_with_pipeline_database_host
PIPELINE_DB_PORT=5432